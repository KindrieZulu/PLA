# ============================================================
# PLA Backend Environment Variables
# Copy this to .env and fill in the values
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Security
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pla_db
POSTGRES_SSL=false

# MongoDB
MONGO_URI=mongodb://localhost:27017/pla_db
MONGO_USER=
MONGO_PASSWORD=

# Redis (for caching, rate limiting, sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# CORS - Comma-separated origins in production
CORS_ORIGIN=http://localhost:3000,http://localhost:19000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# Sentry Error Tracking
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Elasticsearch (optional - for log aggregation)
ELASTICSEARCH_NODE=
ELASTICSEARCH_INDEX=pla-logs

# Prometheus Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# CDN Configuration
CDN_URL=https://cdn.example.com
CDN_API_KEY=

# Session Configuration
SESSION_SECRET=your-session-secret-min-32-chars
SESSION_MAX_AGE=86400000

# Admin Configuration
ADMIN_EMAIL=admin@pla.local
ADMIN_PASSWORD=change-me-in-production

# Docker Configuration
DOCKER_REDIS_HOST=redis
DOCKER_POSTGRES_HOST=postgres